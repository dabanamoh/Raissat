# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Web3Forms access key for the contact form (https://web3forms.com)
VITE_HOOKFORM_ACCESS_KEY=

# GitHub OAuth App used by the content manager at /admin.
# Create one at https://github.com/settings/developers → OAuth Apps → New.
#   Homepage URL:               https://raissat-delta.vercel.app   (later: https://raissat.org)
#   Authorization callback URL: https://raissat-delta.vercel.app/api/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
