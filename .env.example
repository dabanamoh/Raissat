# Copy to .env for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Web3Forms access key for the contact form (https://web3forms.com)
VITE_HOOKFORM_ACCESS_KEY=

# TinaCloud project for the content manager at /admin (https://app.tina.io).
# Project → Overview: Client ID.  Project → Tokens: a "Content (read only)" token.
# Not needed for local editing (`npm run dev` uses a local backend).
TINA_PUBLIC_CLIENT_ID=
TINA_TOKEN=
